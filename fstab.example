# LVM Persistent Mount Examples
# Generated by lvm_management.sh
# Format: UUID=<uuid>  <mountpoint>  <fstype>  defaults  0  0

UUID=abc12345-xxxx-xxxx-xxxx-xxxxxxxxxxxx  /mnt/data   ext4  defaults  0  0
UUID=def67890-xxxx-xxxx-xxxx-xxxxxxxxxxxx  /mnt/backup xfs   defaults  0  0
UUID=ghi11111-xxxx-xxxx-xxxx-xxxxxxxxxxxx  swap        swap  defaults  0  0
